  "reviews": [
    {
      "id": 1,
      "dishId": 1,
      "author": "Анна К.",
      "text": "Очень вкусный борщ, напомнил бабушкин! Густой, наваристый, пампушки просто тают во рту.",
      "photoUrl": "https://i.pravatar.cc/80?img=1",
      "rating": 5
    },
    {
      "id": 2,
      "dishId": 1,
      "author": "Михаил П.",
      "text": "Хороший борщ, но мне показалось немного пресноватым. В целом доволен.",
      "photoUrl": "https://i.pravatar.cc/80?img=2",
      "rating": 4
    },
    {
      "id": 3,
      "dishId": 2,
      "author": "Светлана М.",
      "text": "Обожаю Том Ям! Здесь он приготовлен идеально — и острый, и ароматный.",
      "photoUrl": "https://i.pravatar.cc/80?img=3",
      "rating": 5
    },
    {
      "id": 4,
      "dishId": 2,
      "author": "Дмитрий В.",
      "text": "Острее чем ожидал, но зато очень ароматный. Порция большая.",
      "photoUrl": "https://i.pravatar.cc/80?img=4",
      "rating": 4
    },
    {
      "id": 5,
      "dishId": 3,
      "author": "Ольга Н.",
      "text": "Свежайшие овощи, много феты. Отличный выбор для лёгкого обеда!",
      "photoUrl": "https://i.pravatar.cc/80?img=5",
      "rating": 5
    },
    {
      "id": 6,
      "dishId": 4,
      "author": "Алексей Р.",
      "text": "Цезарь как цезарь. Курица сочная, соус вкусный, но гренок маловато.",
      "photoUrl": "https://i.pravatar.cc/80?img=6",
      "rating": 4
    },
    {
      "id": 7,
      "dishId": 5,
      "author": "Игорь Т.",
      "text": "Стейк просто великолепен! Мраморность отличная, прожарка Medium идеальная.",
      "photoUrl": "https://i.pravatar.cc/80?img=7",
      "rating": 5
    },
    {
      "id": 8,
      "dishId": 5,
      "author": "Наталья С.",
      "text": "Дорогой, но того стоит. Пюре нежнейшее, соус насыщенный.",
      "photoUrl": "https://i.pravatar.cc/80?img=8",
      "rating": 5
    },
    {
      "id": 9,
      "dishId": 6,
      "author": "Павел Д.",
      "text": "Паста al dente, соус кремовый. Отличная карбонара!",
      "photoUrl": "https://i.pravatar.cc/80?img=9",
      "rating": 5
    },
    {
      "id": 10,
      "dishId": 7,
      "author": "Кирилл Ж.",
      "text": "Крылышки огонь! В прямом смысле. Берите только если любите острое.",
      "photoUrl": "https://i.pravatar.cc/80?img=10",
      "rating": 5
    },
    {
      "id": 11,
      "dishId": 8,
      "author": "Виктория Л.",
      "text": "Тирамису нежнейшее, кофейный аромат насыщенный. Лучший десерт в меню!",
      "photoUrl": "https://i.pravatar.cc/80?img=11",
      "rating": 5
    },
    {
      "id": 12,
      "dishId": 10,
      "author": "Евгений Б.",
      "text": "Простая и вкусная Маргарита. Тесто тонкое, хрустящее.",
      "photoUrl": "https://i.pravatar.cc/80?img=12",
      "rating": 4
    }
